{
  "name": "yingrenchuanshuo",
  "version": "0.1.0",
  "description": "樱刃传说 —— 二次元竖版放置类传奇手游",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "icons": "node scripts/gen-icons.mjs",
    "monsters": "node scripts/gen-battle-monsters.mjs",
    "chat": "node scripts/chat.mjs",
    "chat:ui": "node scripts/chat-server.mjs",
    "broadcast": "node scripts/broadcast.mjs",
    "broadcast:start": "cmd /c scripts\\start-broadcast.bat",
    "assets:catkin": "node scripts/build-catkin-portraits.mjs && node scripts/align-catkin-layers.mjs && node scripts/build-catkin-boutique-assets.mjs && node scripts/build-catkin-skill-assets.mjs && node scripts/build-catkin-cardboard-assets.mjs && node scripts/validate-catkin-assets.mjs && node scripts/validate-catkin-cardboard-assets.mjs",
    "assets:catkin-cardboard": "node scripts/build-catkin-cardboard-assets.mjs && node scripts/validate-catkin-cardboard-assets.mjs",
    "assets:equipment-dungeon": "node scripts/build-equipment-dungeon-assets.mjs && node scripts/validate-equipment-dungeon-assets.mjs",
    "assets:equipment-dungeon:check": "node scripts/validate-equipment-dungeon-assets.mjs",
    "assets:affection": "node scripts/build-affection-round2-assets.mjs && node scripts/validate-affection-assets.mjs",
    "assets:affection:check": "node scripts/validate-affection-assets.mjs",
    "qa:affection-save": "tsx scripts/create-affection-round2-qa-save.mts",
    "balance:equipment-dungeon": "tsx scripts/equipment-dungeon-balance.mts",
    "typecheck": "vue-tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "sim": "tsx scripts/simulate.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1449690477/yingrenchuanshuo.git"
  },
  "license": "MIT",
  "dependencies": {
    "@lucide/vue": "^1.27.0",
    "focus-trap": "^8.2.2",
    "idb": "^8.0.3",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
