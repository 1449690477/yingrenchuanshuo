# 联机排行榜（docs/51 / docs/52）
# 复制本文件为 .env 并填入真实值；.env 已在 .gitignore 中，不会进仓库。
#
# 不配置 = 纯单机模式：试炼与本地成绩簿照常可玩，联机榜静默关闭。

# Supabase 项目 URL（Project Settings → API → Project URL）
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 匿名公钥（Project Settings → API → anon public key；不要填 service_role！）
VITE_SUPABASE_ANON_KEY=your-anon-public-key
